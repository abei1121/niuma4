<!DOCTYPE html>
<html lang="zh-CN" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AGY Agent OS & Strategy Mission Control</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#ecfdf5',
              500: '#10b981',
              600: '#059669',
              900: '#064e3b',
            },
            dark: {
              bg: '#080c14',
              card: '#0f172a',
              border: '#1e293b',
              hover: '#1e293b'
            }
          }
        }
      }
    }
  </script>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
    .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: #0f172a; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }
    .glass-panel { background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.08); }
  </style>
</head>
<body class="bg-[#080c14] text-gray-100 min-h-screen flex flex-col custom-scrollbar">

  <!-- Top Global Header -->
  <header class="border-b border-gray-800/80 bg-[#0b1120]/95 backdrop-blur sticky top-0 z-40 px-6 py-3 flex items-center justify-between shadow-xl">
    <div class="flex items-center space-x-3.5">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-emerald-500 via-cyan-500 to-indigo-500 flex items-center justify-center shadow-lg shadow-emerald-500/20">
        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
      </div>
      <div>
        <div class="flex items-center space-x-2">
          <h1 class="text-base font-bold tracking-tight text-white">POLYMARKET AGENT OS</h1>
          <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-mono">Mission Control v4.0</span>
        </div>
        <p class="text-[11px] text-gray-400">实盘限价跟单 • 链上资产矩阵 • 大模型核心 • 系统守护管线</p>
      </div>
    </div>

    <!-- Quick Status Badges & Refresh -->
    <div class="flex items-center space-x-3">
      <div class="hidden lg:flex items-center space-x-3 bg-gray-900/90 px-3 py-1.5 rounded-lg border border-gray-800 text-xs">
        <div class="flex items-center space-x-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-gray-300">GTC 限价引擎 (1USD/5份)</span>
        </div>
        <div class="w-px h-3 bg-gray-700"></div>
        <div class="flex items-center space-x-1.5">
          <span class="w-2 h-2 rounded-full bg-purple-400"></span>
          <span class="text-gray-300">分身3号 旗舰驱动</span>
        </div>
      </div>

      <button onclick="fetchAllData()" class="px-3.5 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold rounded-lg shadow-sm transition flex items-center space-x-1.5">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
        <span>刷新数据</span>
      </button>
    </div>
  </header>

  <!-- Level 1: Clean Primary Categories (4 Big Domains) -->
  <div class="border-b border-gray-800/80 bg-[#0f172a]/90 px-6">
    <div class="flex space-x-8 text-xs font-bold uppercase tracking-wider">
      <button onclick="switchCategory('trading')" id="cat-trading" class="cat-btn py-3.5 border-b-2 border-emerald-500 text-emerald-400 flex items-center space-x-2">
        <span>🎯 量化跟单与交易 (Trading Deck)</span>
      </button>
      <button onclick="switchCategory('accounts')" id="cat-accounts" class="cat-btn py-3.5 border-b-2 border-transparent text-gray-400 hover:text-gray-200 flex items-center space-x-2">
        <span>💼 多链资产与多账号 (Accounts & Assets)</span>
      </button>
      <button onclick="switchCategory('brain')" id="cat-brain" class="cat-btn py-3.5 border-b-2 border-transparent text-gray-400 hover:text-gray-200 flex items-center space-x-2">
        <span>🧠 Agent 大脑与能力库 (Brain & Skills)</span>
      </button>
      <button onclick="switchCategory('system')" id="cat-system" class="cat-btn py-3.5 border-b-2 border-transparent text-gray-400 hover:text-gray-200 flex items-center space-x-2">
        <span>⚙️ 系统基座与运维 (System Ops)</span>
      </button>
    </div>
  </div>

  <!-- Level 2: Sub-Nav Bar (Changes based on selected category) -->
  <div class="border-b border-gray-800/60 bg-[#0b1120]/70 px-6 py-2">
    <!-- Category 1 Sub-Nav: Trading Deck -->
    <div id="subnav-trading" class="flex space-x-2 text-xs">
      <button onclick="switchSubTab('smart-money')" id="subtab-smart-money" class="subtab-btn px-3 py-1.5 rounded-lg bg-emerald-600/20 text-emerald-400 border border-emerald-500/30 font-medium">💎 聪明钱实盘跟单</button>
      <button onclick="switchSubTab('early-bird')" id="subtab-early-bird" class="subtab-btn px-3 py-1.5 rounded-lg bg-gray-900 text-gray-400 hover:text-gray-200">🦅 早鸟候选池 (Top 20)</button>
      <button onclick="switchSubTab('polymarket')" id="subtab-polymarket" class="subtab-btn px-3 py-1.5 rounded-lg bg-gray-900 text-gray-400 hover:text-gray-200">🏛️ Polymarket CLOB</button>
      <button onclick="switchSubTab('predict-fun')" id="subtab-predict-fun" class="subtab-btn px-3 py-1.5 rounded-lg bg-gray-900 text-gray-400 hover:text-gray-200">🔮 Predict.fun SDK</button>
      <button onclick="switchSubTab('real-trades')" id="subtab-real-trades" class="subtab-btn px-3 py-1.5 rounded-lg bg-gray-900 text-gray-400 hover:text-gray-200">📈 真实交易对账</button>
      <button onclick="switchSubTab('blacklist')" id="subtab-blacklist" class="subtab-btn px-3 py-1.5 rounded-lg bg-gray-900 text-gray-400 hover:text-gray-200">🛡️ 风控黑名单</button>
    </div>

    <!-- Category 2 Sub-Nav: Accounts & Assets -->
    <div id="subnav-accounts" class="hidden flex space-x-2 text-xs">
      <button onclick="switchSubTab('accounts-matrix')" id="subtab-accounts-matrix" class="subtab-btn px-3 py-1.5 rounded-lg bg-emerald-600/20 text-emerald-400 border border-emerald-500/30 font-medium">💼 多账号全链资产矩阵</button>
    </div>

    <!-- Category 3 Sub-Nav: Brain & Skills -->
    <div id="subnav-brain" class="hidden flex space-x-2 text-xs">
      <button onclick="switchSubTab('agent-brain')" id="subtab-agent-brain" class="subtab-btn px-3 py-1.5 rounded-lg bg-emerald-600/20 text-emerald-400 border border-emerald-500/30 font-medium">🧠 大模型大脑 & GEMINI.md</button>
      <button onclick="switchSubTab('skills')" id="subtab-skills" class="subtab-btn px-3 py-1.5 rounded-lg bg-gray-900 text-gray-400 hover:text-gray-200">⚡ 技能生态库 (12项)</button>
      <button onclick="switchSubTab('wiki')" id="subtab-wiki" class="subtab-btn px-3 py-1.5 rounded-lg bg-gray-900 text-gray-400 hover:text-gray-200">📚 Wiki 知识图谱 (280篇)</button>
    </div>

    <!-- Category 4 Sub-Nav: System Ops -->
    <div id="subnav-system" class="hidden flex space-x-2 text-xs">
      <button onclick="switchSubTab('overview')" id="subtab-overview" class="subtab-btn px-3 py-1.5 rounded-lg bg-emerald-600/20 text-emerald-400 border border-emerald-500/30 font-medium">⚡ 全景态势与硬件</button>
      <button onclick="switchSubTab('services')" id="subtab-services" class="subtab-btn px-3 py-1.5 rounded-lg bg-gray-900 text-gray-400 hover:text-gray-200">⚙️ 常驻守护 & Crontab</button>
      <button onclick="switchSubTab('logs')" id="subtab-logs" class="subtab-btn px-3 py-1.5 rounded-lg bg-gray-900 text-gray-400 hover:text-gray-200">📜 全量实时日志流</button>
    </div>
  </div>

  <!-- Main Content Container -->
  <main class="flex-1 p-6 space-y-6 max-w-7xl w-full mx-auto">

    <!-- Toast Notification -->
    <div id="toast" class="fixed bottom-6 right-6 z-50 transform transition-all duration-300 translate-y-20 opacity-0 pointer-events-none px-4 py-3 rounded-xl glass-panel border border-emerald-500/30 text-emerald-300 text-xs font-semibold shadow-2xl flex items-center space-x-2">
      <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
      <span id="toast-msg">操作成功</span>
    </div>

    <!-- VIEW: SMART MONEY (TRADING DECK) -->
    <div id="view-smart-money" class="space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-base font-bold text-white">💎 聪明钱实盘跟单中枢 (Smart Money Strategy Hub)</h2>
          <p class="text-xs text-gray-400 mt-0.5">严格基于底层代码事实：GTC 限价挂单 • 1 USD 保底或 5 份额 • 0.10~0.85 价格风控 • 单标的最多 2 笔 • 6 分钟撤单</p>
        </div>
        <div class="flex items-center space-x-2">
          <span class="px-2.5 py-1 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs font-semibold">
            跟单引擎：运行中 (GTC 限价)
          </span>
        </div>
      </div>

      <!-- Strategy Parameters Form (100% Code Facts) -->
      <div class="glass-panel p-5 rounded-2xl border border-gray-800 space-y-4">
        <div class="flex justify-between items-center border-b border-gray-800 pb-3">
          <div>
            <div class="text-xs font-bold text-gray-200">🛠️ 实盘跟单策略风控参数 (物理配置: /home/a/polymarket-bot/strategy_config.json)</div>
            <div class="text-[11px] text-gray-400">遵循 Polymarket CLOB 最小 5 份额规范与大鳄建仓门槛，保存后免重启热生效</div>
          </div>
          <button onclick="saveSmartMoneyConfig()" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-semibold transition flex items-center space-x-1.5 shadow-lg shadow-emerald-500/20">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/></svg>
            <span>💾 保存并实时热生效跟单策略配置</span>
          </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 text-xs">
          <div>
            <label class="block text-gray-400 font-semibold mb-1">跟单下单类型 (Order Type)</label>
            <input id="cfg-order-type" type="text" readonly value="GTC 限价单 (Limit Order)" class="w-full px-3 py-2 bg-gray-900/60 border border-gray-800 rounded-lg text-emerald-400 font-mono font-bold cursor-not-allowed">
            <div class="text-[10px] text-gray-500 mt-1">1:1 限价跟随，严禁市价滑点亏损</div>
          </div>

          <div>
            <label class="block text-gray-400 font-semibold mb-1">每笔下单份额规则 (Sizing)</label>
            <input id="cfg-sizing-mode" type="text" readonly value="1 USD 保底 或 5 份额" class="w-full px-3 py-2 bg-gray-900/60 border border-gray-800 rounded-lg text-emerald-400 font-mono font-bold cursor-not-allowed">
            <div class="text-[10px] text-gray-500 mt-1">price≥0.20 买 5 份; price&lt;0.20 买 ceil(1/P) 份</div>
          </div>

          <div>
            <label class="block text-gray-400 font-semibold mb-1">最低买入单价 (防粉尘攻击)</label>
            <input id="cfg-min-price" type="number" step="0.01" value="0.10" class="w-full px-3 py-2 bg-gray-900 border border-gray-700 rounded-lg text-white font-mono focus:outline-none focus:border-emerald-500">
            <div class="text-[10px] text-gray-500 mt-1">&lt; $0.10 的买单一律 0ms 直接丢弃</div>
          </div>

          <div>
            <label class="block text-gray-400 font-semibold mb-1">最高买入限价 (防追高熔断)</label>
            <input id="cfg-max-price" type="number" step="0.01" value="0.85" class="w-full px-3 py-2 bg-gray-900 border border-gray-700 rounded-lg text-white font-mono focus:outline-none focus:border-emerald-500">
            <div class="text-[10px] text-gray-500 mt-1">&gt; $0.85 熔断跳过，防止劣质盈亏比</div>
          </div>

          <div>
            <label class="block text-gray-400 font-semibold mb-1">巨鲸盘口持仓门槛 (USDC)</label>
            <input id="cfg-whale-pos" type="number" step="10" value="120.0" class="w-full px-3 py-2 bg-gray-900 border border-gray-700 rounded-lg text-white font-mono focus:outline-none focus:border-emerald-500">
            <div class="text-[10px] text-gray-500 mt-1">大鳄盘口持仓 ≥ $120 且 60s 内有建仓</div>
          </div>

          <div>
            <label class="block text-gray-400 font-semibold mb-1">单标的最大跟单笔数</label>
            <input id="cfg-max-orders" type="number" step="1" value="2" class="w-full px-3 py-2 bg-gray-900 border border-gray-700 rounded-lg text-white font-mono focus:outline-none focus:border-emerald-500">
            <div class="text-[10px] text-gray-500 mt-1">我方在同一盘口累计最多跟发 2 笔</div>
          </div>

          <div>
            <label class="block text-gray-400 font-semibold mb-1">未成交挂单超时撤单 (秒)</label>
            <input id="cfg-cancel-timeout" type="number" step="30" value="360" class="w-full px-3 py-2 bg-gray-900 border border-gray-700 rounded-lg text-white font-mono focus:outline-none focus:border-emerald-500">
            <div class="text-[10px] text-gray-500 mt-1">6 分钟 (360s) 未撮合自动撤单释放资金</div>
          </div>

          <div>
            <label class="block text-gray-400 font-semibold mb-1">成交后自动限价止盈 (USDC)</label>
            <input id="cfg-take-profit" type="number" step="0.01" value="0.99" class="w-full px-3 py-2 bg-gray-900 border border-gray-700 rounded-lg text-white font-mono focus:outline-none focus:border-emerald-500">
            <div class="text-[10px] text-gray-500 mt-1">买单撮合后自动以 $0.99 挂限价单止盈</div>
          </div>
        </div>
      </div>

      <!-- Add Whitelist Custom Whale -->
      <div class="glass-panel p-5 rounded-2xl border border-gray-800 space-y-3">
        <div class="text-xs font-bold text-gray-300">手动录入实盘跟单巨鲸 (/home/a/smart_wallets.json)</div>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-2">
          <input id="input-new-wallet-addr" type="text" placeholder="0x... (42位 EVM 钱包地址)" class="px-3 py-2 bg-gray-900 border border-gray-700 rounded-lg text-xs font-mono text-white focus:outline-none focus:border-indigo-500 md:col-span-2">
          <input id="input-new-wallet-name" type="text" placeholder="巨鲸别名 (例如: CS2-Sniper-Whale)" class="px-3 py-2 bg-gray-900 border border-gray-700 rounded-lg text-xs font-mono text-white focus:outline-none focus:border-indigo-500">
          <button onclick="addCustomWhale()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg text-xs font-semibold transition">
            + 授权并写入实盘白名单
          </button>
        </div>
      </div>

      <!-- True Smart Wallets Table -->
      <div class="glass-panel rounded-2xl border border-gray-800 overflow-hidden">
        <div class="p-4 bg-gray-900/60 border-b border-gray-800 flex justify-between items-center">
          <div class="flex items-center space-x-2">
            <span class="text-xs font-bold text-gray-200">当前实盘跟单白名单库 (/home/a/smart_wallets.json)</span>
            <span class="text-[10px] px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-mono font-bold" id="smart-whitelist-count-badge">8 位实盘大鳄</span>
          </div>
          <span class="text-[11px] text-gray-500">真实成交获利知情巨鲸矩阵 (支持随时自由移出)</span>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-gray-900/80 text-gray-400 uppercase font-semibold border-b border-gray-800">
              <tr>
                <th class="py-3 px-4">序号</th>
                <th class="py-3 px-4">巨鲸标签 / 别名</th>
                <th class="py-3 px-4">钱包公钥地址</th>
                <th class="py-3 px-4">主攻垂直领域</th>
                <th class="py-3 px-4">已结清净利润</th>
                <th class="py-3 px-4">胜率</th>
                <th class="py-3 px-4">盈亏比</th>
                <th class="py-3 px-4">风控价格区间</th>
                <th class="py-3 px-4 text-right">操作</th>
              </tr>
            </thead>
            <tbody id="smart-money-table" class="divide-y divide-gray-800/60 font-mono">
              <!-- Populated by JS -->
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- VIEW: EARLY BIRD POOL -->
    <div id="view-early-bird" class="hidden space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-base font-bold text-white">早鸟敏锐内幕【待选候选池】(Top 20 动态淘汰)</h2>
          <p class="text-xs text-gray-400 mt-0.5">算法与大模型从链上挖掘出的内幕先知候选 • 点击「+ 加入跟单」即可写入实盘白名单</p>
        </div>
      </div>

      <div class="glass-panel rounded-2xl border border-gray-800 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-gray-900/80 text-gray-400 uppercase font-semibold border-b border-gray-800">
              <tr>
                <th class="py-3.5 px-4">排名</th>
                <th class="py-3.5 px-4">候选地址</th>
                <th class="py-3.5 px-4">领域画像</th>
                <th class="py-3.5 px-4">评级</th>
                <th class="py-3.5 px-4">胜率</th>
                <th class="py-3.5 px-4">均价 (获胜倍数)</th>
                <th class="py-3.5 px-4">早期体量</th>
                <th class="py-3.5 px-4">领先时长</th>
                <th class="py-3.5 px-4">综合评分</th>
                <th class="py-3.5 px-4 text-right">操作</th>
              </tr>
            </thead>
            <tbody id="early-bird-table" class="divide-y divide-gray-800/60 font-mono">
              <!-- Populated by JS -->
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- VIEW: POLYMARKET CLOB -->
    <div id="view-polymarket" class="hidden space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-base font-bold text-white">Polymarket CLOB SDK 交易中枢 (V2 EIP-712)</h2>
          <p class="text-xs text-gray-400 mt-0.5">本地 Node Sidecar (端口 8088) 极速高并发交易与挂单通道</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="glass-panel p-5 rounded-2xl border border-gray-800 space-y-2">
          <div class="text-xs font-semibold text-gray-400">USDC 交易可用余额 (Real)</div>
          <div class="text-2xl font-extrabold text-emerald-400" id="poly-deck-usdc">1.00 USDC</div>
          <div class="text-[11px] text-gray-500">Polygon Native (0x3c49...3359)</div>
        </div>

        <div class="glass-panel p-5 rounded-2xl border border-gray-800 space-y-2">
          <div class="text-xs font-semibold text-gray-400">POL 燃料余额 (Gas)</div>
          <div class="text-2xl font-extrabold text-cyan-400" id="poly-deck-pol">12.78 POL</div>
          <div class="text-[11px] text-gray-500">足额支持 10,000+ 笔挂撤单</div>
        </div>

        <div class="glass-panel p-5 rounded-2xl border border-gray-800 space-y-2">
          <div class="text-xs font-semibold text-gray-400">CLOB 侧车状态</div>
          <div class="flex items-center space-x-2 pt-1">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-base font-bold text-emerald-400">127.0.0.1:8088 在线</span>
          </div>
          <div class="text-[11px] text-gray-500">EIP-712 签名就绪</div>
        </div>

        <div class="glass-panel p-5 rounded-2xl border border-gray-800 space-y-3 flex flex-col justify-between">
          <div class="text-xs font-semibold text-gray-400">快捷交易控制</div>
          <div class="flex space-x-2">
            <button onclick="triggerPolyTestOrder()" class="flex-1 px-3 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg text-xs font-semibold transition">
              ⚡ 签名测速
